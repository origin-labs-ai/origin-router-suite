{
  "name": "origin-router-desktop",
  "version": "0.5.116",
  "private": true,
  "description": "OriginRouter Desktop window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir --x64 && node scripts/desktop-installer.cjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ai.originlabs.originrouter.desktop",
    "productName": "OriginRouter Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "afterPack": "scripts/afterPack.js",
    "extraResources": [
      {
        "from": "../dist/win",
        "to": "server"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
